# RBC Guardian P1 — environment. Copy to .env and fill in. Never commit .env.
# Server-side only: none of these reach the browser (there is no NEXT_PUBLIC_ secret).

# mock | live   (mock needs nothing else and is the default)
ALEBEX_MODE=mock

# Required for live browser voice: your Alebex Voice Engine key (wt_...), from the developer console.
# ALEBEX_VOICE_TOKEN and ALEB_API_KEY are accepted as aliases.
ALEBEX_API_KEY=

# One Alebex agent per role (copy IDs from app.alebex.ai/dev → Voice Agents)
ALEBEX_AGENT_TRUSTLINE_ID=
ALEBEX_AGENT_SENTINEL_ID=
ALEBEX_AGENT_RECOVERY_ID=

# Single-agent fallback: used for any role above that is empty
ALEBEX_AGENT_DEFAULT_ID=

# Public HTTPS origin that forwards to the gateway (port 3001), required for live Custom Tools.
# Without it, live mode runs voice-only with tools disabled. See `pnpm tunnel`.
PUBLIC_TOOL_BASE_URL=

# 32+ random characters used to sign short-lived per-session tool tokens and call tickets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOOL_SIGNING_SECRET=

# Local application data (path is relative to apps/gateway)
DATABASE_URL=file:./data/guardian.db
APP_ORIGIN=http://localhost:3000
GATEWAY_ORIGIN=http://127.0.0.1:3001

# Optional diagnostics only, not used by the primary voice path
ALEBEX_ASR_TOKEN=
